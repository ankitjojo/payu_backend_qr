<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PayU Zion Automation Testing</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>Zion Subscription Mandate Setup</h1>
        <p>This UI tests the Custom Merchant Hosted Checkout for setting up a PayU Zion Mandate.</p>
        
        <form id="mandateForm">
            <div class="form-group">
                <label for="amount">Amount (INR)</label>
                <input type="text" id="amount" value="1.00" required>
            </div>
            <div class="form-group">
                <label for="productinfo">Product Info</label>
                <input type="text" id="productinfo" value="Subscription Plan A" required>
            </div>
            <div class="form-group">
                <label for="firstname">First Name</label>
                <input type="text" id="firstname" value="John" required>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" value="john@example.com" required>
            </div>
            <div class="form-group">
                <label for="phone">Phone</label>
                <input type="text" id="phone" value="9876543210" required>
            </div>

            <div class="form-group">
                <label for="vpa">UPI ID (VPA) for Collect</label>
                <input type="text" id="vpa" value="success@ybl" placeholder="e.g. user@upi">
            </div>

            <fieldset>
                <legend>SI Details (Standing Instruction)</legend>
                <div class="form-group">
                    <label for="billingAmount">Billing Amount</label>
                    <input type="text" id="billingAmount" value="2.00" required>
                </div>
                <div class="form-group">
                    <label for="billingCycle">Billing Cycle</label>
                    <select id="billingCycle">
                        <option value="MONTHLY">Monthly</option>
                        <option value="YEARLY">Yearly</option>
                        <option value="WEEKLY">Weekly</option>
                        <option value="DAILY">Daily</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="paymentStartDate">Start Date</label>
                    <input type="date" id="paymentStartDate" required>
                </div>
                <div class="form-group">
                    <label for="paymentEndDate">End Date</label>
                    <input type="date" id="paymentEndDate" required>
                </div>
            </fieldset>

            <div class="buttons">
                <button type="submit" id="submitBtn">Initiate Mandate Setup (Web)</button>
                <button type="button" id="qrBtn" style="margin-top: 10px; background-color: #4CAF50;">Generate QR Mandate</button>
                <button type="button" id="upiCollectBtn" style="margin-top: 10px; background-color: #9C27B0;">Setup Mandate via UPI ID</button>
            </div>
        </form>

        <div id="responseContainer" class="hidden">
            <h3>Response from Backend</h3>
            <pre id="jsonResponse"></pre>
            <p id="redirectText">The backend generated the payload. Redirecting to PayU...</p>
            <div id="qrCodeContainer" style="display: none; text-align: center; margin-top: 20px;">
                <h4>Scan this QR to setup mandate:</h4>
                <img id="qrImage" src="" alt="QR Code" style="border: 1px solid #ccc; padding: 10px; border-radius: 8px;">
                <p id="qrIntentText" style="word-break: break-all; font-size: 12px; margin-top: 10px; font-family: monospace;"></p>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode/1.5.1/qrcode.min.js"></script>
    <script src="endpoints.js"></script>
    <script src="logic.js"></script>
</body>
</html>
